{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustedProxies"
      ],
      "properties": {
        "trustedProxies": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 49,
            "anyOf": [
              {
                "description": "Canonical IPv4 host or CIDR with prefix /8 through /32; runtime also rejects host bits.",
                "pattern": "^(?:(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[01][0-9]|22[0-3])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5]))(?:/(?:[89]|[12][0-9]|3[0-2]))?$"
              },
              {
                "description": "IPv6 host or CIDR with prefix /32 through /128; runtime performs canonical network validation.",
                "allOf": [
                  {
                    "pattern": "^[0-9A-Fa-f:]+(?:/(?:3[2-9]|[4-9][0-9]|1[01][0-9]|12[0-8]))?$"
                  },
                  {
                    "pattern": ":"
                  },
                  {
                    "not": {
                      "pattern": "^::(?:/[0-9]+)?$"
                    }
                  },
                  {
                    "not": {
                      "pattern": "^[Ff][Ff]"
                    }
                  },
                  {
                    "not": {
                      "pattern": ":::"
                    }
                  },
                  {
                    "not": {
                      "pattern": "::.*::"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "path": { "type": "string", "const": "/metrics", "default": "/metrics" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string", "default": "" },
            "secretKey": { "type": "string", "default": "token", "minLength": 1 }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "interval": { "type": "string", "default": "30s" },
        "scrapeTimeout": { "type": "string", "default": "10s" },
        "additionalLabels": {
          "type": "object",
          "default": { "release": "kube-prometheus-stack" },
          "additionalProperties": { "type": "string" }
        },
        "relabelings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app": { "type": "string", "default": "tokenplace" },
            "environment": { "type": "string", "default": "" },
            "release": { "type": "string", "default": "" },
            "cluster": { "type": "string", "default": "" }
          }
        }
      }
    }
  }
}
