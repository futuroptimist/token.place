{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustedProxies",
        "storage"
      ],
      "properties": {
        "trustedProxies": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 49,
            "anyOf": [
              {
                "description": "Canonical IPv4 host or CIDR with prefix /8 through /32; runtime also rejects host bits.",
                "pattern": "^(?:(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[01][0-9]|22[0-3])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5]))(?:/(?:[89]|[12][0-9]|3[0-2]))?$"
              },
              {
                "description": "IPv6 host or CIDR with prefix /32 through /128; runtime performs canonical network validation.",
                "allOf": [
                  {
                    "pattern": "^[0-9A-Fa-f:]+(?:/(?:3[2-9]|[4-9][0-9]|1[01][0-9]|12[0-8]))?$"
                  },
                  {
                    "pattern": ":"
                  },
                  {
                    "not": {
                      "pattern": "^::(?:/[0-9]+)?$"
                    }
                  },
                  {
                    "not": {
                      "pattern": "^[Ff][Ff]"
                    }
                  },
                  {
                    "not": {
                      "pattern": ":::"
                    }
                  },
                  {
                    "not": {
                      "pattern": "::.*::"
                    }
                  }
                ]
              }
            ]
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "secretKey"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "path": {
          "type": "string",
          "const": "/metrics",
          "default": "/metrics"
        },
        "mode": {
          "type": "string",
          "enum": [
            "normal",
            "degraded"
          ],
          "default": "normal"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "default": ""
            },
            "secretKey": {
              "type": "string",
              "default": "token",
              "minLength": 1
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "interval": {
          "type": "string",
          "default": "30s"
        },
        "scrapeTimeout": {
          "type": "string",
          "default": "10s"
        },
        "additionalLabels": {
          "type": "object",
          "default": {
            "release": "kube-prometheus-stack"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "relabelings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app": {
              "type": "string",
              "default": "tokenplace"
            },
            "environment": {
              "type": "string",
              "default": ""
            },
            "release": {
              "type": "string",
              "default": ""
            },
            "cluster": {
              "type": "string",
              "default": ""
            }
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "rollingUpdate"
      ],
      "properties": {
        "type": {
          "enum": [
            "Recreate",
            "RollingUpdate"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxUnavailable",
            "maxSurge"
          ],
          "properties": {
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxSurge": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers",
        "legacyRoutes"
      ],
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "legacyRoutes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "stateBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "valkey"
      ],
      "properties": {
        "type": {
          "enum": [
            "memory",
            "valkey"
          ]
        },
        "valkey": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "discovery",
            "direct",
            "sentinel",
            "environment",
            "cluster",
            "schema",
            "acknowledgementKey",
            "auth",
            "tls",
            "timeouts",
            "retryAttempts"
          ],
          "properties": {
            "discovery": {
              "enum": [
                "direct",
                "sentinel"
              ]
            },
            "direct": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host",
                "port"
              ],
              "properties": {
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "sentinel": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "endpointsJson",
                "service",
                "auth"
              ],
              "properties": {
                "endpointsJson": {
                  "type": "string"
                },
                "service": {
                  "type": "string"
                },
                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "existingSecret",
                    "usernameKey",
                    "passwordKey"
                  ],
                  "properties": {
                    "existingSecret": {
                      "type": "string"
                    },
                    "usernameKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "passwordKey": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "environment": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$|^$"
            },
            "cluster": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$|^$"
            },
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "major",
                "readerRevision",
                "writerRevision",
                "supportedSchemaReadMin",
                "supportedSchemaReadMax",
                "supportedWriterMin",
                "supportedWriterMax",
                "activeSchemaRevision",
                "activeWriterRevision",
                "migrationEpoch"
              ],
              "properties": {
                "major": {
                  "type": "integer",
                  "minimum": 1
                },
                "readerRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "writerRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "supportedSchemaReadMin": {
                  "type": "integer",
                  "minimum": 1
                },
                "supportedSchemaReadMax": {
                  "type": "integer",
                  "minimum": 1
                },
                "supportedWriterMin": {
                  "type": "integer",
                  "minimum": 1
                },
                "supportedWriterMax": {
                  "type": "integer",
                  "minimum": 1
                },
                "activeSchemaRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "activeWriterRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "migrationEpoch": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "acknowledgementKey": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "existingSecret",
                "secretKey"
              ],
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "secretKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "existingSecret",
                "usernameKey",
                "passwordKey"
              ],
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "usernameKey": {
                  "type": "string",
                  "minLength": 1
                },
                "passwordKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "existingSecret",
                "caCertKey",
                "clientCertKey",
                "clientKeyKey"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "existingSecret": {
                  "type": "string"
                },
                "caCertKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientCertKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientKeyKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "timeouts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "connectSeconds",
                "socketSeconds",
                "commandSeconds",
                "retrySeconds"
              ],
              "properties": {
                "connectSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "socketSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "commandSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "retrySeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "retryAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        }
      }
    }
  }
}
