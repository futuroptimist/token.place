+; TOKEN_PLACE_GUARD_BEGIN
+!define TOKEN_PLACE_CROSS_FORMAT_MESSAGE "TOKEN_PLACE_COMPETING_INSTALLER: token.place desktop ownership could not be verified. Uninstall the existing version first, or choose an empty, separate installation folder. Your existing app, settings and models have not been changed."
+Function TokenPlacePreviewOwnership
+  StrCpy $TokenPlacePhase "preview"
+  Call TokenPlaceVerifyOwnership
+  StrCpy $TokenPlacePhase "verify"
+FunctionEnd
+Function TokenPlaceVerifyOwnership
+  Push $0
+  Push $1
+  StrCpy $TokenPlaceRetained ""
+  ${If} $TokenPlaceOldRemoved = 1
+    StrCpy $TokenPlaceRetained $TokenPlaceOwnedTarget
+  ${EndIf}
+  ClearErrors
+  ExecWait '"$PLUGINSDIR\ownership.exe" "$INSTDIR" "${PRODUCTNAME}" "${MANUFACTURER}" "${MAINBINARYNAME}.exe" "$TokenPlaceRetained" "$PLUGINSDIR\ownership.ini" "$TokenPlacePhase"' $0
+  ${If} ${Errors}
+    Call TokenPlaceAbortCrossFormat
+  ${EndIf}
+  ${If} $0 != 0
+  ${AndIf} $0 != 10
+    Call TokenPlaceAbortCrossFormat
+  ${EndIf}
+  ReadINIStr $1 "$PLUGINSDIR\ownership.ini" "ownership" "target"
+  ${If} $1 == ""
+    Call TokenPlaceAbortCrossFormat
+  ${EndIf}
+  ${If} $TokenPlaceOwnedTarget != ""
+  ${AndIf} $TokenPlaceOwnedTarget != $1
+    Call TokenPlaceAbortCrossFormat
+  ${EndIf}
+  ${If} $0 = 10
+    StrCpy $TokenPlaceOwnedTarget $1
+  ${EndIf}
+  Pop $1
+  Pop $0
+FunctionEnd
+
+Function TokenPlaceAbortCrossFormat
+  StrCpy $TokenPlaceResult "${TOKEN_PLACE_CROSS_FORMAT_MESSAGE}"
+  ${If} $TokenPlaceOldRemoved = 1
+    StrCpy $TokenPlaceResult "TOKEN_PLACE_INTERRUPTED_UPGRADE: ownership changed after the old NSIS app was removed. Settings and models were retained. Stop and repair the installation before retrying."
+  ${EndIf}
+  Call TokenPlaceRefuse
+FunctionEnd
+Function TokenPlaceRefuse
+  System::Call 'kernel32::GetStdHandle(i -11)p.r0'
+  ${If} $0 == 0
+  ${OrIf} $0 == -1
+    System::Call 'kernel32::AttachConsole(i -1)'
+    System::Call 'kernel32::GetStdHandle(i -11)p.r0'
+  ${EndIf}
+  ${If} $0 != 0
+  ${AndIf} $0 != -1
+    FileWrite $0 "$TokenPlaceResult$\r$\n"
+  ${EndIf}
+  IfSilent tp_refusal_exit
+  ClearErrors
+  ${GetOptions} $CMDLINE "/P" $0
+  ${If} ${Errors}
+    MessageBox MB_OK|MB_ICONSTOP "$TokenPlaceResult"
+  ${EndIf}
+  tp_refusal_exit:
+  SetErrorLevel 1638
+  Quit
+FunctionEnd
+!define TOKEN_PLACE_RUNNING_MESSAGE "TOKEN_PLACE_APP_RUNNING: Close token.place before installing or uninstalling, then retry. The app may be running or its process identity could not be verified. No process was stopped."
+!macro TokenPlaceProcessGuard PREFIX
+Function ${PREFIX}TokenPlaceCheckProcesses
+  Push $0
+  ClearErrors
+  ExecWait '"$PLUGINSDIR\ownership.exe" --processes "$INSTDIR" "${MAINBINARYNAME}.exe"' $0
+  ${If} ${Errors}
+    StrCpy $0 1638
+  ${EndIf}
+  ${If} $0 != 0
+    DetailPrint "${TOKEN_PLACE_RUNNING_MESSAGE}"
+    System::Call 'kernel32::GetStdHandle(i -11)p.r0'
+    ${If} $0 == 0
+    ${OrIf} $0 == -1
+      System::Call 'kernel32::AttachConsole(i -1)'
+      System::Call 'kernel32::GetStdHandle(i -11)p.r0'
+    ${EndIf}
+    ${If} $0 != 0
+    ${AndIf} $0 != -1
+      FileWrite $0 "${TOKEN_PLACE_RUNNING_MESSAGE}$\r$\n"
+    ${EndIf}
+    IfSilent tp_process_refusal
+    ${If} $PassiveMode != 1
+      MessageBox MB_OK|MB_ICONSTOP "${TOKEN_PLACE_RUNNING_MESSAGE}"
+    ${EndIf}
+    tp_process_refusal:
+    SetErrorLevel 1638
+    Quit
+  ${EndIf}
+  Pop $0
+FunctionEnd
+!macroend
+!insertmacro TokenPlaceProcessGuard ""
+!insertmacro TokenPlaceProcessGuard "un."
+; TOKEN_PLACE_GUARD_END
+
